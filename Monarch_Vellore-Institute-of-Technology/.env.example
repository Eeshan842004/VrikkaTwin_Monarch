# Copy to .env and change the secrets. Demo-only keys are generated at startup if these are empty.
APP_MODE=api                 # api = Streamlit calls FastAPI; inprocess = Streamlit imports the engine (hosting fallback)
API_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-jwt-secret
FERNET_KEY=                  # PII encryption key (Fernet.generate_key())
AUDIT_KEY=change-me-audit-hmac-key
OPENMETEO_BASE=https://archive-api.open-meteo.com/v1/archive
WHISPER_MODEL=small          # use "base" if the image gets too big

# Demo logins (role: password). Demo only; never reuse.
DEMO_DOCTOR_PASSWORD=doctor-demo
DEMO_PATIENT_PASSWORD=patient-demo
DEMO_ASHA_PASSWORD=asha-demo
DEMO_LAB_PASSWORD=lab-demo
DEMO_ADMIN_PASSWORD=admin-demo
